}

#[tauri::command]
async fn upsert_model_config(
    model_name: String,
    provider: String,
    input_cost_per_1k: f64,
    output_cost_per_1k: f64,
    state: State<'_, AppState>,
) -> Result<String, String> {
    let db_guard = state.db.lock().unwrap();
    let db = db_guard.as_ref().ok_or("Database not initialized")?;

    db.upsert_model_config(&model_name, &provider, input_cost_per_1k, output_cost_per_1k)
        .map_err(|e| format!("Failed to upsert model config: {}", e))
}

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        .plugin(tauri_plugin_opener::init())
        .setup(|app| {
            Ok(AppState {
                db: Mutex::new(None),
                config_path: "config.json".to_string(),
            })
        })
        .invoke_handler(tauri::generate_handler![
            // Basic commands
            greet,
            get_app_info,
            init_database,
            get_projects,
            create_project,
            get_tasks,
            create_task,
            update_task,
            delete_task,
            add_agent_connection,
            sync_agent_sessions,
            search_knowledge,
            create_agent_stat,
            update_agent_stat_tokens,
            update_agent_stat_code,
            update_agent_stat_tasks,
            get_agent_stats,
            upsert_model_config,
            // Knowledge graph commands
            add_entity,
            add_relationship,
            get_entity,
            get_entities_by_type,
            get_related_entities,
            extract_entities_from_text,
            extract_relationships_from_text,
            get_graph_data,
            update_entity_mastery,
            update_entity_importance,
            find_shortest_path,
            find_clusters,
            // Spaced repetition commands
            create_review_card,
            generate_flashcards_from_knowledge,
            review_card,
            get_due_cards,
            get_review_stats,
            start_review_session,
            delete_review_card,
            // Journal commands
            create_journal,
            get_journal,
            get_recent_journals,
            add_journal_entry,
            get_journal_entries,
            update_journal,
            start_time_entry,
            stop_time_entry,
            get_running_time_entry,
            get_time_entries,
            generate_daily_report,
            generate_weekly_report,
            add_completed_task_to_journal,
            add_knowledge_to_journal,
            // Agent package manager commands
            get_available_agents,
            get_installed_agents,
            check_environment,
            install_agent,
            uninstall_agent,
            agent_health_check,
            update_agent_config,
            get_agent_config
        ])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}
